{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "An authored desktop shell over moving landscapes; project worlds retain their own visual identities.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.043,
          0.059,
          0.047
        ],
        "hex": "#0b0f0c"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.663,
          0.69,
          0.655
        ],
        "hex": "#a9b0a7"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.784,
          1,
          0.263
        ],
        "hex": "#c8ff43"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.914,
          0.91,
          0.875
        ],
        "hex": "#e9e8df"
      }
    },
    "window": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.039,
          0.055,
          0.043
        ],
        "hex": "#0a0e0be0"
      }
    },
    "windowSolid": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.067,
          0.082,
          0.063
        ],
        "hex": "#111510"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.722,
          0.741,
          0.71
        ],
        "hex": "#b8bdb5"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "window": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "control": {
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "circular": {
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontSize": {
          "value": 4,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": -0.055,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "interface": {
      "$type": "typography",
      "$value": {
        "fontFamily": "SFMono-Regular, Roboto Mono, Consolas, monospace",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 500,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "metadata": {
      "$type": "typography",
      "$value": {
        "fontFamily": "SFMono-Regular, Roboto Mono, Consolas, monospace",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0.02,
          "unit": "em"
        }
      }
    }
  }
}